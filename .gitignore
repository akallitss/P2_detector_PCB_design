# Whitelist: only code, configs and text docs are tracked.
# No drawings (Gerbers, masks, STEP/STL, KiCad, PDFs, rendered figures/pages).
/*
!/.gitignore
!/README.md

!/Version_Sept26/
/Version_Sept26/*
!/Version_Sept26/tools/
!/Version_Sept26/config/
!/Version_Sept26/README.md
!/Version_Sept26/PRODUCTION_SUMMARY.md
!/Version_Sept26/production_summary.csv

!/Drift_Contact_Oct26/
/Drift_Contact_Oct26/*
!/Drift_Contact_Oct26/tools/
/Drift_Contact_Oct26/tools/vendor/
!/Drift_Contact_Oct26/README.md
!/Drift_Contact_Oct26/data/
/Drift_Contact_Oct26/data/*
!/Drift_Contact_Oct26/data/results.json

!/B2_DriftPad_Oct26/
/B2_DriftPad_Oct26/*
!/B2_DriftPad_Oct26/tools/
!/B2_DriftPad_Oct26/README.md
!/B2_DriftPad_Oct26/CHANGES.txt
!/B2_DriftPad_Oct26/QC/
/B2_DriftPad_Oct26/QC/*
!/B2_DriftPad_Oct26/QC/qc_report.txt

!/PCB_NextVersion_Oct26/
/PCB_NextVersion_Oct26/*
!/PCB_NextVersion_Oct26/tools/
!/PCB_NextVersion_Oct26/data/
!/PCB_NextVersion_Oct26/README.md

__pycache__/
*.pyc
*.png
*.gbr
*.drl
*.step
*.stl
*.pdf
